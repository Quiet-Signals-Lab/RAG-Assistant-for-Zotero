{
  "name": "zotero-llm-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --no-warnings scripts/desk.check.mjs && node --experimental-strip-types --no-warnings scripts/chat.check.mjs && node --experimental-strip-types --no-warnings scripts/csl.check.ts"
  },
  "dependencies": {
    "citeproc": "^2.4.63",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^5.5.0",
    "vite": "^8.0.16"
  }
}
