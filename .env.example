# Optional environment variables. Copy to .env to use; nothing here is required.
# Everything else (Zotero path, models, index location) is set in the app's Settings.

# Provider API keys. The Settings page shows a key found here as "from the environment".
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# MISTRAL_API_KEY=...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# References and citations: a Semantic Scholar key raises the rate limit.
# SEMANTIC_SCHOLAR_API_KEY=...

# Where the embedding models are cached (default: ~/.cache/torch/sentence_transformers).
# SENTENCE_TRANSFORMERS_HOME=/path/to/models
